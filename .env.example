# Copia este archivo como ".env" y rellena UNA de las dos claves.
# NUNCA subas el archivo .env real a ningún lado ni lo compartas por chat.

# --- OPCIÓN A: Google Gemini (tiene capa gratuita) ---
# Consíguela en https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (Opcional) Modelo de Gemini. Por defecto: gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# --- OPCIÓN B: Claude (Anthropic) ---
# Consíguela en https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=
# (Opcional) Modelo de Claude. Por defecto: claude-opus-4-8
# CLAUDE_MODEL=claude-opus-4-8

# (Opcional) Forzar proveedor: "gemini" o "claude".
# Si no se fija, usa Gemini si hay GEMINI_API_KEY; si no, Claude.
# LLM_PROVIDER=gemini

# --- Fuente de datos: Redash (recomendado) ---
# Si estas 3 variables están, el chatbot toma los datos de tu consulta de Redash.
# Si faltan, usa el Excel de ejemplo como respaldo.
REDASH_URL=
REDASH_QUERY_ID=
REDASH_API_KEY=

# (Opcional) Ajuste de zona horaria. Redash entrega las fechas en UTC y la app las
# pasa a hora de Colombia (UTC-5) restando 5 horas. Si algún día la consulta ya
# devuelve hora local, poner 0 aquí para que no se reste nada.
# HORAS_UTC_A_LOCAL=-5

# --- (Alternativa) Conexión directa a Postgres ---
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
# DATABASE_URL=

# --- Acceso privado al chatbot (usuario + clave) ---
# Si APP_PASSWORD está vacío, el chatbot queda SIN protección (acceso abierto).
APP_USER=
APP_PASSWORD=

# --- Correo de alerta cuando se disparan los autodiagnósticos (alertas.py) ---
# Si SMTP_CLAVE está vacío, la alerta NO envía nada: solo avisa por consola.
# Con Gmail / Google Workspace hay que usar una "contraseña de aplicación"
# (Cuenta de Google -> Seguridad -> Contraseñas de aplicaciones), no la clave
# normal del correo.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=

# (Opcional) Si la empresa da un relay de correo interno que autoriza por IP y no
# pide clave, poner el servidor en SMTP_HOST y activar esto:
# SMTP_SIN_LOGIN=1
# (Opcional) Si ese relay va sin cifrado, normalmente en el puerto 25:
# SMTP_SIN_TLS=1

# (Opcional) Desde qué dirección se ve que llega el correo. Por defecto,
# SMTP_USUARIO. Útil si el servidor autoriza enviar "en nombre de" otra cuenta.
# ALERTA_REMITENTE=alertas@fibrazo.com

# Quién recibe la alerta, separados por coma. Si se deja vacío, usa la lista
# que está escrita en alertas.py (el equipo de CX).
ALERTA_DESTINATARIOS=

# Enlace al termómetro, para el botón del correo.
ALERTA_URL_APP=

# (Opcional) Si el pico sigue hora tras hora, cada cuántas horas repetir el
# aviso. Por defecto 3, para no mandar un correo por hora en un evento largo.
# ALERTA_CADA_N_HORAS=3

# (Opcional) Si el dato de Redash viene con más atraso que esto, no avisa
# (sería una alerta sobre algo ya pasado). Por defecto 6 horas.
# ALERTA_MAX_ATRASO_HORAS=6

# (Opcional) "1" fuerza una corrida nueva de la consulta en Redash antes de
# revisar. Es lo que hace que la alerta sea del momento: el resultado en caché
# de Redash puede tener horas de atraso. Por defecto 1.
# ALERTA_REFRESCAR_REDASH=1
